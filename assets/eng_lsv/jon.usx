style="w" strong="H3372">fear</char> <char style="w" strong="H3068">YHWH</char> [<char style="w" strong="H3068">with</char>] <char style="w" strong="H3068">a</char> <char style="w" strong="H1419">great</char> <char style="w" strong="H3372">fear</char>, <char style="w" strong="H3068">and</char> <char style="w" strong="H2077">sacrifice</char> <char style="w" strong="H3068">a</char> <char style="w" strong="H2077">sacrifice</char> <char style="w" strong="H3068">to</char> <char style="w" strong="H3068">YHWH</char>, <char style="w" strong="H3068">and</char> <char style="w" strong="H5088">vow</char> <char style="w" strong="H5088">vows</char>. <verse eid="JON 1:16" /><verse style="v" number="17" sid="JON 1:17" />And <char style="w" strong="H3068">YHWH</char> appoints <char style="w" strong="H3068">a</char> great fish to swallow up Jonah, and Jonah is in the bowels of the fish three days and three nights.<verse eid="JON 1:17" /></para>
