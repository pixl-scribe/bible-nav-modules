ou</char>, <char style="w" strong="H3068">O</char> <char style="w" strong="H3068">YHWH</char>, <char style="w" strong="H3588">until</char> <char style="w" strong="H3588">when</char>? <verse eid="PSA 6:3" /><verse style="v" number="4" sid="PSA 6:4" />Turn back, <char style="w" strong="H3068">O</char> <char style="w" strong="H3068">YHWH</char>, draw <char style="w" strong="H5704">out</char> <char style="w" strong="H3068">my</char> <char style="w" strong="H5315">soul</char>, || <char style="w" strong="H5315">Save</char> <char style="w" strong="H5315">me</char> <char style="w" strong="H5704">for</char> <char style="w" strong="H3068">Your</char> kindness’ sake. <verse eid="PSA 6:4" /><verse style="v" number="5" sid="PSA 6:5" /><char style="w" strong="H4616">For</char> <char style="w" strong="H3068">in</char> <char style="w" strong="H5315">death</char> <char style="w" strong="H7725">there</char> <char style="w" strong="H3068">is</char> no memorial <char style="w" strong="H3068">of</char> <char style="w" strong="H7725">You</char>, || <char style="w" strong="H3068">In</char> Sheol, <char style="w" strong="H3068">who</char> <char style="w" strong="H7725">gives</char> thanks <char style="w" strong="H7725">to</char> <char style="w" strong="H7725">You</char>? <verse eid="PSA 6:5" /><verse style="v" number="6" sid="PSA 6:6" /><char style="w" strong="H3588">I</char> <char style="w" strong="H3588">have</char> <char style="w" strong="H4194">been</char> weary <char style="w" strong="H7585">with</char> <char style="w" strong="H3588">my</char> sighing, || <char style="w" strong="H3588">I</char> meditate [<char style="w" strong="H4194">on</char>] <char style="w" strong="H3588">my</char> bed <char style="w" strong="H3588">through</char> all <char style="w" strong="H3588">the</char> night, || <char style="w" strong="H3588">I</char> dissolve <char style="w" strong="H3588">my</char> couch <char style="w" strong="H7585">with</char> <char style="w" strong="H3588">my</char> tear. <verse eid="