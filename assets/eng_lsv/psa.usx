char style="w" strong="H3467">my</char> soul, || <char style="w" strong="H8034">They</char> <char style="w" strong="H8034">have</char> <char style="w" strong="H3467">not</char> set God before <char style="w" strong="H3467">them</char>. Selah. <verse eid="PSA 54:3" /><verse style="v" number="4" sid="PSA 54:4" />Behold, God [<char style="w" strong="H6310">is</char>] <char style="w" strong="H3068">a</char> helper <char style="w" strong="H8085">to</char> <char style="w" strong="H8085">me</char>, || <char style="w" strong="H8085">The</char> Lord [<char style="w" strong="H6310">is</char>] <char style="w" strong="H8085">with</char> <char style="w" strong="H8085">those</char> supporting <char style="w" strong="H8085">my</char> soul, <verse eid="PSA 54:4" /><verse style="v" number="5" sid="PSA 54:5" /><char style="w" strong="H7760">Turn</char> back <char style="w" strong="H5921">the</char> evil <char style="w" strong="H5921">to</char> <char style="w" strong="H7760">my</char> <char style="w" strong="H6965">enemies</char>, || Cut <char style="w" strong="H5921">them</char> <char style="w" strong="H5921">off</char> <char style="w" strong="H5921">in</char> <char style="w" strong="H5921">Your</char> <char style="w" strong="H3808">truth</char>. <verse eid="PSA 54:5" /><verse style="v" number="6" sid="PSA 54:6" /><char style="w" strong="H2009">I</char> sacrifice <char style="w" strong="H5315">to</char> <char style="w" strong="H5315">You</char> <char style="w" strong="H5315">with</char> <char style="w" strong="H3068">a</char> free-will offering, || <char style="w" strong="H2009">I</char> thank <char style="w" strong="H2009">Your</char> Name, <char style="w" strong="H3068">O</char> <char style="w" strong="H3068">YHWH</char>, <char style="w" strong="H5315">for</char> [<char style="w" strong="H2009">it</char> <char style="w" strong="H5315">is</char>] good, <verse eid="PSA 54:6" /><verse style="v" number="7" sid="PSA 54:7" /><char style="w" strong="H7451">For</char> <char style="w" stron