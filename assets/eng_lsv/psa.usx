" strong="H7442">for</char> <char style="w" strong="H5315">herself</char>, || <char style="w" strong="H2691">Where</char> <char style="w" strong="H3820">she</char> <char style="w" strong="H3068">has</char> placed <char style="w" strong="H1571">her</char> brood—<char style="w" strong="H3068">Your</char> altars, <char style="w" strong="H3068">O</char> <char style="w" strong="H3068">YHWH</char> <char style="w" strong="H3068">of</char> Hosts, || <char style="w" strong="H3068">My</char> king <char style="w" strong="H3068">and</char> <char style="w" strong="H3068">my</char> <char style="w" strong="H3068">God</char>. <verse eid="PSA 84:3" /><verse style="v" number="4" sid="PSA 84:4" /><char style="w" strong="H3068">O</char> <char style="w" strong="H3068">the</char> blessedness <char style="w" strong="H4428">of</char> those inhabiting <char style="w" strong="H3068">Your</char> <char style="w" strong="H1004">house</char>, || <char style="w" strong="H1571">Yet</char> <char style="w" strong="H3068">they</char> praise <char style="w" strong="H4672">You</char>. Selah. <verse eid="PSA 84:4" /><verse style="v" number="5" sid="PSA 84:5" /><char style="w" strong="H3068">O</char> <char style="w" strong="H1984">the</char> blessedness <char style="w" strong="H1004">of</char> <char style="w" strong="H3068">a</char> man whose strength <char style="w" strong="H1004">is</char> <char style="w" strong="H3427">in</char> <char style="w" strong="H3427">You</char>, || Highways [<char style="w" strong="H1004">are</char>] <char style="w" strong="H3427">in</char> <char style="w" strong="H3427">their</char> heart. <verse eid="PSA 84:5" /><verse style="v" number="6" sid="PSA 84:6" />Those passing through <char style="w" strong="H3068">a</char> valley <char style="w" strong="H3824">of</char> weeping make it <char style="w" strong="H3068">a</char> spring, || <char style="w" strong="H5797">The</char> early rain covers it <char style="w" strong="H3824">with</char> pools. <verse eid="PSA 84:6" /><verse style="v" number="7" sid="PSA 84:7" /><char style="w" strong="H1571">They</char> <char style="w" strong="H5674">go</char> <char style="w" strong="H5674">from</char> strength <char style="w" strong="H5674">to</char> strength, || <char style="w" strong="H1571">He</char> appears <char style="w" strong="H5674">to</char> God <char style="w" strong="H1571">in</char> Zion. <verse eid="PSA 84:7" /><verse style="v" number="8" sid="PSA 84:8" /><char style="w" strong="H3068">O</char> <char style="w" strong="H3068">YHWH</char>, God <char style="w" strong="H2428">of</char> <char style="w" strong="H2428">Hosts</char>, hear <char style="w" strong="H7200">my</char> prayer, || <char style="w" strong="H7200">Give</char> ear, <char style="w" strong="H3068">O</char> God <char style="w" strong="H2428">of</char> Jacob. Selah. <verse eid="PSA 84:8" /><verse style="v" number="9" sid="PSA 84:9" /><char style="w" strong="H3068">Our</char> shield, see, <char style="w" strong="H3068">O</char> <char style="w" strong="H3068">God</char>, || <char style="w" strong="H3068">And</char> behold <char style="w" strong="H8085">the</char> face <char style="w" strong="H3068">of</char> <char style="w" strong="H3068">Your</char> anointed, <verse eid="PSA 84:9" /><verse style="v" number="10" sid="PSA 84:10" /><char style="w" strong="H6440">For</char> <char style="w" strong="H3068">a</char> day <char style="w" strong="H6440">in</char> <char style="w" strong="H6440">Your</char> courts [<char style="w" strong="H6440">is</char>] <char style="w" strong="H6440">good</char>, <char style="w" strong="H3068">O</char> Teacher! <char style="w" strong="H7200">I</char> <char style="w" strong="H7200">have</char> <char style="w" strong="H4899">chosen</char> rather <char style="w" strong="H6440">to</char> <char style="w" strong="H6440">be</char> <char style="w" strong="H7200">at</char> <char style="w" strong="H6440">the</char> threshold, || <char style="w" strong="H6440">In</char> <char style="w" strong="H6440">the</char> house