  <para style="p"><verse style="v" number="1" sid="NAM 2:1" /><char style="w" strong="H3068">A</char> scatterer <char style="w" strong="H3063">has</char> <char style="w" strong="H5674">come</char> <char style="w" strong="H5921">up</char> <char style="w" strong="H5921">to</char> <char style="w" strong="H3605">your</char> face, || <char style="w" strong="H2287">Keep</char> <char style="w" strong="H3605">the</char> bulwark, <char style="w" strong="H2009">watch</char> <char style="w" strong="H3605">the</char> <char style="w" strong="H5674">way</char>, || Strengthen <char style="w" strong="H3605">the</char> loins, strengthen power mightily. <verse eid="NAM 2:1" /><verse style="v" number="2" sid="NAM 2:2" /><char style="w" strong="H5921">For</char> <char style="w" strong="H3068">YHWH</char> <char style="w" strong="H5341">has</char> turned <char style="w" strong="H5927">back</char> <char style="w" strong="H5927">to</char> <char style="w" strong="H6440">the</char> excellence <char style="w" strong="H6440">of</char> Jacob, || <char style="w" strong="H5927">As</char> [<char style="w" strong="H5927">to</char>] <char style="w" strong="H6440">the</char> excellence <char style="w" strong="H6440">of</char> Israel, || <char style="w" strong="H5921">For</char> emptiers <char style="w" strong="H5921">have</char> emptied <char style="w" strong="H5921">them</char> <char style="w" strong="H2388">out</char>, || <char style="w" strong="H6440">And</char> <char style="w" strong="H5921">they</char> <char style="w" strong="H5921">have</char> marred <char style="w" strong="H6440">their</char> branches. <verse eid="NAM 2:2" /><verse style="v" number="3" sid="NAM 2:3" /><char style="w" strong="H3588">The</char> shield <char style="w" strong="H3068">of</char> <char style="w" strong="H3068">his</char> mighty ones <char style="w" strong="H3068">has</char> <char style="w" strong="H7725">become</char> red, || <char style="w" strong="H3478">Men</char> <char style="w" strong="H3068">of</char> <char sty